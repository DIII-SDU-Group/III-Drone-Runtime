# Example iii-runtime-api environment.
# Copy to a local, untracked env file and replace placeholder secrets.
# For field use, set profile=real and replace both IDs and both secrets. The
# runtime refuses to start in real mode with any development/default value.

III_RUNTIME_API_ID=iii-runtime-sim
III_RUNTIME_API_NAME=III Runtime Sim
III_RUNTIME_API_PROFILE=sim
III_RUNTIME_API_HOST=0.0.0.0
III_RUNTIME_API_PORT=8765

# mDNS/discovery metadata.
III_RUNTIME_API_MDNS_ENABLED=1
III_RUNTIME_API_MDNS_INSTANCE=III Runtime API Sim
# Optional. Leave unset to advertise the host's primary local IPv4 address.
# III_RUNTIME_API_MDNS_HOST=192.168.1.10
III_RUNTIME_API_SYSTEM_ID=iii-drone-sim

# Secrets. Do not commit real values.
III_RUNTIME_API_BROWSER_PASSWORD=change-me-browser-password
III_RUNTIME_API_CLI_TOKEN=change-me-cli-token
# Set to 1 in real deployments or any environment where defaults must fail.
III_RUNTIME_API_REQUIRE_SECRETS=0

# Session lease.
III_RUNTIME_API_HEARTBEAT_INTERVAL_SEC=2
III_RUNTIME_API_SESSION_LEASE_TIMEOUT_SEC=8

# PX4 command adapter.
III_RUNTIME_API_PX4_MAVLINK_ENDPOINT=udpin://0.0.0.0:14540
III_RUNTIME_API_PX4_ENABLED=1

# Logs.
III_RUNTIME_API_LOG_DIR=/tmp/iii_drone/runtime-api
III_RUNTIME_SESSION_LOG_ROOT=
III_RUNTIME_SESSION_DEBUG=0
III_RECEIVER_CLOCK_STATE_PATH=/var/lib/iii/deployment/clock-state.json
